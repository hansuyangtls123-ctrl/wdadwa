-- ==================== MAIN LOOP ====================
RunService.RenderStepped:Connect(function()
    pcall(function()
        target = getNearestEnemy()
        
        if Aimbot and target and target.Character and target.Character:FindFirstChild("Head") then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Character.Head.Position)
        end
        
        if Teleport and target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local headPos = target.Character.HumanoidRootPart.Position
                root.CFrame = CFrame.new(headPos + Vector3.new(0, 5, 0))
            end
        end
        
        if PrepMovement then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 16
            end
        end
    end)
end)

